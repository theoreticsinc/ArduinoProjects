const int masterListSize = sizeof(masterList) / sizeof(masterList[0]);

void setup() {
  Serial.begin(115200);
  
  // Enable Watchdog timer with a 2-second timeout interval
  wdt_enable(WDTO_2S);

  pinMode(SSR_PIN, OUTPUT);
  digitalWrite(SSR_PIN, LOW); // Barrier defaults to closed

  SPI.begin();
  mfrc522.PCD_Init();
  
  // Set antenna gain to maximum sensitivity
  mfrc522.PCD_SetAntennaGain(mfrc522.RxGain_max);

  Serial.println(F("\n--- System Ready ---"));
  Serial.println(F("Waiting for RFID Cards..."));
}

void loop() {
  // Feed watchdog timer
  wdt_reset();

  // Look for new card
  if (!mfrc522.PICC_IsNewCardPresent() || !mfrc522.PICC_ReadCardSerial()) {
    return;
  }

  // Print raw UID
  Serial.print(F("UID: "));
  printUID(mfrc522.uid.uidByte, mfrc522.uid.size);

  // Validate UID
  if (isAuthorized(mfrc522.uid.uidByte, mfrc522.uid.size)) {
    Serial.println(F(" : AUTH -> Barrier Open"));
    openBarrier();
  } else {
    Serial.println(F(" : UNREGD -> Denied"));
  }

  // Halt card reading
  mfrc522.PICC_HaltA();
  mfrc522.PCD_StopCrypto1();
}

bool isAuthorized(byte* scannedUid, byte size) {
  if (size != 4) return false; // This list checks standard 4-byte UIDs

  for (int i = 0; i < masterListSize; i++) {
    bool match = true;
    for (byte j = 0; j < 4; j++) {
      byte flashByte = pgm_read_byte(&(masterList[i][j]));
      if (scannedUid[j] != flashByte) {
        match = false;
        break;
      }
    }
    if (match) return true;
  }
  return false;
}

void printUID(byte* uidBytes, byte size) {
  for (byte i = 0; i < size; i++) {
    if (uidBytes[i] < 0x10) {
      Serial.print(F("0"));
    }
    Serial.print(uidBytes[i], HEX);
  }
}

void openBarrier() {
  digitalWrite(SSR_PIN, HIGH);
  
  // Maintain relay output while feeding the Watchdog Timer
  unsigned long startTime = millis();
  while (millis() - startTime < BARRIER_DELAY) {
    wdt_reset();
  }
  
  digitalWrite(SSR_PIN, LOW);
}